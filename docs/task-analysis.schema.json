{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trendmodel:task-analysis:v1",
  "title": "TrendModel Task Analysis",
  "description": "Router-facing JSON returned by the local TensorFlow task classifier.",
  "type": "object",
  "required": [
    "original_prompt",
    "workload_type",
    "intent",
    "complexity",
    "predictions",
    "effort",
    "evidence",
    "task_ir",
    "fusion",
    "needs_clarification",
    "clarification_reasons",
    "confidence",
    "model_version"
  ],
  "properties": {
    "original_prompt": {"type": "string"},
    "workload_type": {"$ref": "#/$defs/workloadLabel"},
    "intent": {"$ref": "#/$defs/intentLabel"},
    "complexity": {"$ref": "#/$defs/complexityLabel"},
    "predictions": {
      "type": "object",
      "required": ["workload_type", "intent", "complexity", "effort"],
      "properties": {
        "workload_type": {"$ref": "#/$defs/classificationHead"},
        "intent": {"$ref": "#/$defs/classificationHead"},
        "complexity": {"$ref": "#/$defs/classificationHead"},
        "effort": {"$ref": "#/$defs/effort"}
      },
      "additionalProperties": true
    },
    "effort": {"$ref": "#/$defs/effort"},
    "task_ir": {"$ref": "#/$defs/taskIR"},
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "fusion": {
      "type": "object",
      "required": [
        "semantic_model",
        "task_ast_schema",
        "post_hoc_probability_fusion",
        "policy"
      ],
      "properties": {
        "semantic_model": {"type": "string"},
        "task_ast_schema": {"type": "string"},
        "post_hoc_probability_fusion": {"type": "boolean"},
        "policy": {"type": "string"}
      },
      "additionalProperties": true
    },
    "needs_clarification": {"type": "boolean"},
    "clarification_reasons": {
      "type": "array",
      "items": {"type": "string"}
    },
    "confidence": {
      "type": "object",
      "required": ["workload_type", "intent", "complexity", "effort", "overall"],
      "properties": {
        "workload_type": {"$ref": "#/$defs/probability"},
        "intent": {"$ref": "#/$defs/probability"},
        "complexity": {"$ref": "#/$defs/probability"},
        "effort": {"$ref": "#/$defs/probability"},
        "overall": {"$ref": "#/$defs/probability"}
      },
      "additionalProperties": true
    },
    "model_version": {"type": "string"}
  },
  "additionalProperties": true,
  "$defs": {
    "probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "workloadLabel": {
      "type": "string",
      "enum": ["text", "code", "analysis", "operations", "planning", "mixed", "other", "unknown"]
    },
    "intentLabel": {
      "type": "string",
      "enum": ["create", "modify", "debug", "explain", "execute", "analyze", "review", "summarize", "translate", "plan", "extract", "classify", "unknown"]
    },
    "complexityLabel": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "classificationHead": {
      "type": "object",
      "required": ["label", "probability", "candidates"],
      "properties": {
        "label": {"type": "string"},
        "probability": {"$ref": "#/$defs/probability"},
        "entropy": {"$ref": "#/$defs/probability"},
        "margin": {"$ref": "#/$defs/probability"},
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "probability"],
            "properties": {
              "label": {"type": "string"},
              "probability": {"$ref": "#/$defs/probability"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "effort": {
      "type": "object",
      "required": ["label", "estimated_minutes", "range_minutes", "confidence", "basis"],
      "properties": {
        "label": {"type": "string", "enum": ["XS", "S", "M", "L", "XL", "unknown"]},
        "probability": {"$ref": "#/$defs/probability"},
        "entropy": {"$ref": "#/$defs/probability"},
        "margin": {"$ref": "#/$defs/probability"},
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "probability"],
            "properties": {
              "label": {"type": "string", "enum": ["XS", "S", "M", "L", "XL"]},
              "probability": {"$ref": "#/$defs/probability"}
            },
            "additionalProperties": true
          }
        },
        "estimated_minutes": {"type": ["integer", "null"], "minimum": 1},
        "range_minutes": {
          "type": ["array", "null"],
          "prefixItems": [
            {"type": "integer", "minimum": 0},
            {"type": "integer", "minimum": 0}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "confidence": {"$ref": "#/$defs/probability"},
        "basis": {
          "type": "string",
          "enum": [
            "bucket_seed_only",
            "trained_effort_bucket_head",
            "trained_observed_effort_head",
            "trained_observed_effort_and_bucket_heads",
            "no_effort_supervision"
          ]
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["kind", "label", "value", "strength", "detail"],
      "properties": {
        "kind": {"type": "string"},
        "label": {"type": "string"},
        "value": {"type": ["string", "boolean", "number"]},
        "strength": {"$ref": "#/$defs/probability"},
        "detail": {"type": "string"},
        "source_span": {
          "type": ["array", "null"],
          "prefixItems": [
            {"type": "integer", "minimum": 0},
            {"type": "integer", "minimum": 0}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "rule_id": {"type": "string"},
        "negated": {"type": "boolean"},
        "quoted": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "taskIR": {
      "type": "object",
      "required": [
        "contract_version",
        "original_prompt",
        "intent",
        "primary_intent",
        "secondary_intents",
        "domains",
        "workload_type",
        "artifact",
        "artifact_probability",
        "operations",
        "language",
        "constraints",
        "capability_demand",
        "complexity",
        "effort",
        "risk_level",
        "confidence",
        "needs_clarification",
        "evidence",
        "fusion",
        "model_version"
      ],
      "properties": {
        "contract_version": {"const": "task-ir-v1"},
        "original_prompt": {"type": "string"},
        "intent": {"$ref": "#/$defs/classificationHead"},
        "primary_intent": {"$ref": "#/$defs/classificationHead"},
        "secondary_intents": {
          "type": "array",
          "items": {"$ref": "#/$defs/classificationHead"}
        },
        "domains": {
          "type": "array",
          "items": {"$ref": "#/$defs/classificationHead"}
        },
        "workload_type": {"$ref": "#/$defs/classificationHead"},
        "artifact": {"type": "string"},
        "artifact_probability": {"$ref": "#/$defs/probability"},
        "operations": {"type": "array", "items": {"type": "string"}},
        "language": {"type": ["string", "null"]},
        "constraints": {"$ref": "#/$defs/taskConstraints"},
        "capability_demand": {"$ref": "#/$defs/capabilityDemand"},
        "complexity": {"$ref": "#/$defs/classificationHead"},
        "effort": {"$ref": "#/$defs/effort"},
        "risk_level": {"type": "string", "enum": ["low", "medium", "high"]},
        "confidence": {
          "type": "object",
          "required": ["overall"],
          "properties": {"overall": {"$ref": "#/$defs/probability"}},
          "additionalProperties": {"$ref": "#/$defs/probability"}
        },
        "needs_clarification": {"type": "boolean"},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        },
        "fusion": {"$ref": "#/$defs/fusionMetadata"},
        "model_version": {"type": "string"}
      },
      "additionalProperties": true
    },
    "taskConstraints": {
      "type": "object",
      "properties": {
        "requires_files": {"type": "boolean"},
        "requires_tools": {"type": "boolean"},
        "has_code_block": {"type": "boolean"},
        "has_file_paths": {"type": "boolean"},
        "has_shell_commands": {"type": "boolean"},
        "has_math_symbols": {"type": "boolean"},
        "has_urls": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "capabilityDemand": {
      "type": "object",
      "required": ["reasoning", "coding", "context", "tool_use"],
      "properties": {
        "reasoning": {"$ref": "#/$defs/probability"},
        "coding": {"$ref": "#/$defs/probability"},
        "context": {"$ref": "#/$defs/probability"},
        "tool_use": {"$ref": "#/$defs/probability"}
      },
      "additionalProperties": true
    },
    "fusionMetadata": {
      "type": "object",
      "required": [
        "semantic_model",
        "task_ast_schema",
        "post_hoc_probability_fusion",
        "policy"
      ],
      "properties": {
        "semantic_model": {"type": "string"},
        "task_ast_schema": {"type": "string"},
        "post_hoc_probability_fusion": {"type": "boolean"},
        "policy": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
